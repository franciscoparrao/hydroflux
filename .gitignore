# Rust
target/
**/*.rs.bk
# Cargo.lock: ignorar mientras el workspace sea una librería de investigación.
# Cuando aparezca un binario final (CLI runner, benchmark fijo), versionarlo
# para reproducibilidad. Decidir caso por caso en el primer release público.
Cargo.lock

# Python (cuando aparezca)
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
.ipynb_checkpoints/

# Datos pesados (referenciar paths externos, no copiar)
data/
# EXCEPCIÓN (convención CLAUDE.md): los datos de benchmarks numéricos
# van EN el repo — son chicos (KB-MB) y el claim de reproducibilidad
# del paper depende de que viajen con el clone. Igual que los fixtures
# de examples/huasco_2d_phase2/data/ (force-added).
!benchmarks/data/
*.tif
*.tiff
*.nc
*.h5
*.hdf5
*.zarr
*.parquet
*.shp
*.shx
*.dbf
*.prj
*.gpkg

# Outputs de simulación
results/
runs/
*.vts
*.vtu
*.vtm

# Logs y outputs temporales
*.log
logs/
tmp/

# Editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# LaTeX (cuando se escriban papers en docs/ o papers/)
*.aux
*.bbl
*.blg
*.log
*.out
*.toc
*.synctex.gz
*.fdb_latexmk
*.fls

# Notebooks profundos (preservar el .ipynb pero no checkpoints)
.ipynb_checkpoints/

# Stray journal-comparison artefacts at repo root (residue from /paper-match
# runs; regenerable from ~/vault/journals/<slug>/ if needed).
/AWR*
/JH*
/NH_guidelines*
/RSASE*

# ANUGA binary outputs (regenerable from m2_anuga_wallclock.py + anuga_stoker_compare.py)
*.sww

# Submission package: regenerated from the manuscript by preflight +
# the latex build. The PDFs are build products; SUBMISSION.md is not.
papers/*/submission/*.pdf
